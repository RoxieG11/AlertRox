# AlertRox — Güvenli Konfigürasyon Şablonu
# Bu dosyayı '.env' olarak kopyalayıp kendi değerlerinizi girin.
# .env dosyası GitHub'a ASLA yüklenmez! (chmod 600 .env yapın)

# Supabase Bilgileri (Dashboard → Settings → API)
# NOT: Kesinlikle service_role KULLANMAYIN! Yalnızca anon/public key kullanın.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Kullanıcı Girişi (Dashboard → Authentication → Users)
AGENT_EMAIL=your-email@example.com
AGENT_PASSWORD=your-secure-password-here

# Cihaz Ayarları
DEVICE_NAME=My-Linux-PC
DEVICE_ID=

# Agent Ayarları
HEARTBEAT_INTERVAL=10
COMMAND_POLL_INTERVAL=3

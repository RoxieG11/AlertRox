# AlertRox — Konfigürasyon Şablonu
# Bu dosyayı '.env' olarak kopyalayıp kendi değerlerinizi girin.
# .env dosyası GitHub'a ASLA yüklenmez!

# Supabase Bilgileri (Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Cihaz Ayarları
DEVICE_NAME=My-Linux-PC
DEVICE_ID=

# Agent Ayarları
HEARTBEAT_INTERVAL=10
COMMAND_POLL_INTERVAL=3
